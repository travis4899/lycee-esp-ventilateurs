(kicad_pcb
  (version 20250114)
  (generator "pcbnew")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (2 "B.Cu" signal)
    (4 "In1.Cu" power)
    (6 "In2.Cu" power)
    (8 "In3.Cu" power)
    (10 "In4.Cu" power)
    (12 "In5.Cu" power)
    (14 "In6.Cu" power)
    (16 "In7.Cu" power)
    (18 "In8.Cu" power)
    (20 "F.Adhes" user)
    (22 "B.Adhes" user)
    (24 "F.Paste" user)
    (26 "B.Paste" user)
    (28 "F.SilkS" user)
    (30 "B.SilkS" user)
    (32 "F.Mask" user)
    (34 "B.Mask" user)
    (36 "Dwgs.User" user)
    (38 "Cmts.User" user)
    (40 "Eco1.User" user)
    (42 "Eco2.User" user)
    (44 "Edge.Cuts" user)
    (46 "Margin" user)
    (48 "B.CrtYd" user)
    (50 "F.CrtYd" user)
    (52 "B.Fab" user)
    (54 "F.Fab" user)
  )
  (setup
    (pad_to_mask_clearance 0)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros yes)
      (usegerberextensions yes)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (gerberprecision 6)
      (excludeedgelayer yes)
      (plotframeref yes)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15)
      (dxfpolygonmode yes)
      ( ಭಾರತೀಯsketchpadsonfab no)
      (plotreference yes)
      (plotvalue yes)
      (gerberprecision 6)
      (subtractmaskfromsilk yes)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "")
    )
  )
  (net 0 "")
)
